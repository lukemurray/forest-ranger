{
	"name": "forest-ranger",
	"version": "1.0.0",
	"description": "Manage your worktrees",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc --noEmit",
		"rebuild": "electron-rebuild -f -w better-sqlite3,node-pty",
		"dist": "electron-vite build && electron-builder",
		"postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.75.1",
		"@agentclientprotocol/codex-acp": "1.10.0",
		"@agentclientprotocol/sdk": "1.4.0",
		"@base-ui-components/react": "1.0.0-rc.0",
		"@tanstack/react-router": "1.170.35",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"better-sqlite3": "13.0.3",
		"monaco-editor": "^0.56.0",
		"node-pty": "1.1.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@electron/rebuild": "4.2.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.5.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"electron": "44.2.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"typescript": "7.0.2",
		"vite": "8.2.2"
	},
	"trustedDependencies": [
		"electron",
		"esbuild",
		"better-sqlite3",
		"node-pty"
	],
	"overrides": {
		"node-abi": "4.35.0"
	},
	"build": {
		"appId": "dev.forestranger.app",
		"productName": "Forest Ranger",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json"
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": "dmg",
			"icon": "build/icon.icns"
		}
	}
}
