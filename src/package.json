{
	"name": "forest-ranger",
	"version": "1.0.0",
	"description": "Manage your worktrees",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc --noEmit",
		"rebuild": "electron-rebuild -f -w better-sqlite3,node-pty",
		"dist": "electron-vite build && electron-builder",
		"postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.54.1",
		"@agentclientprotocol/codex-acp": "1.0.2",
		"@agentclientprotocol/sdk": "1",
		"@base-ui-components/react": "1.0.0-rc.0",
		"@tanstack/react-router": "1.170.17",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"better-sqlite3": "12.11.1",
		"node-pty": "1.1.0",
		"react": "19.2.7",
		"react-diff-view": "3.3.3",
		"react-dom": "19.2.7",
		"react-markdown": "10.1.0",
		"refractor": "5.0.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@electron/rebuild": "4.1.0",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "26.1.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"electron": "43.0.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"typescript": "6.0.3",
		"vite": "8.1.3"
	},
	"trustedDependencies": ["electron", "esbuild", "better-sqlite3", "node-pty"],
	"build": {
		"appId": "dev.forestranger.app",
		"productName": "Forest Ranger",
		"directories": {
			"output": "release"
		},
		"files": ["out/**/*", "package.json"],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": "dmg",
			"icon": "build/icon.icns"
		}
	}
}
